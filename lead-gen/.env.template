# Bright Data Scraper Studio (AI Lead Generator)
# Get these from https://brightdata.com dashboard -> Scraper Studio -> your collector
BRIGHT_DATA_API_TOKEN=your_bright_data_api_token_here
BRIGHT_DATA_COLLECTOR_ID=your_collector_id_here

# Local Ollama (lead qualification against icp.yaml)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Direct-contact fallback (used instead of marketplace routing)
FALLBACK_CONTACT_METHOD=your_email_here@example.com

# Optional: output location for generated lead batches (kept local, never committed)
LEAD_OUTPUT_DIR=./output