# Bright Data Scraper Studio (AI Lead Generator)
# Get these from https://brightdata.com dashboard -> Scraper Studio -> your collector
BRIGHT_DATA_API_TOKEN=your_bright_data_api_token_here
BRIGHT_DATA_COLLECTOR_ID=your_collector_id_here

# Local Ollama (lead qualification against icp.yaml)
# No API key needed -- qualification runs on your own hardware. Make sure
# Ollama is running (`ollama serve`) and the model below is pulled
# (`ollama pull phi4-mini` or your preferred model).
#
# Docker deployment ONLY: set OLLAMA_BASE_URL=http://ollama:11434 (the
# compose stack provides an "ollama" service; see ../DEPLOYMENT.md).
# Leave as localhost when running `streamlit run lead_generator.py` locally.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=phi4-mini:latest

# Direct-contact fallback (used instead of marketplace routing)
FALLBACK_CONTACT_METHOD=your_email_here@example.com

# Optional: output location for generated lead batches (kept local, never committed)
LEAD_OUTPUT_DIR=./output

# Optional: comma-separated input URLs used by the headless CLI (./run.ps1 or
# `python lead_generator.py`) when no --urls / --inputs-file is passed.
# Not used by the Streamlit UI (that gets URLs from its text area).
BRIGHT_DATA_INPUT_URLS=
