# lead-gen/.env.template
# Copy to lead-gen/.env and fill in real values. Never commit the filled .env.

BRIGHT_DATA_API_TOKEN=

# Local Ollama settings -- no API key needed, qualification runs on your
# own hardware. Make sure Ollama is running (`ollama serve`) and the model
# below is pulled (`ollama pull llama3.1:8b` or your preferred model).
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Optional: path override for the ideal-customer-profile config (defaults to
# ./icp.yaml relative to this directory)
ICP_CONFIG_PATH=./icp.yaml
